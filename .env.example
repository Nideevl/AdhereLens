# Copy to .env and fill in. ./dev.sh start does this for you with random values if .env is missing.
# .env is git-ignored. Never commit real values.

DB_USER=adherelens
DB_PASSWORD=change_me

# Signs login tokens. At least 32 characters. Shared by all four services.
JWT_SECRET=change_me_at_least_32_characters_long

# Shared key for service-to-service calls (/internal/**).
INTERNAL_API_KEY=change_me

# Keyed-hash secret for patient pseudonyms in analytics. Changing it changes every pseudonym.
PSEUDONYM_SECRET=change_me

# First platform admin, created at startup if none exists.
BOOTSTRAP_ADMIN_EMAIL=admin@adherelens.local
BOOTSTRAP_ADMIN_PASSWORD=change_me

# Optional: real SMS and calls. Also set adherelens.twilio.enabled=true in notification-service.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
